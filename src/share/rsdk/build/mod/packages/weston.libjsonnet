local base_packages = import "categories/base.libjsonnet";

function(suite,
         product,
         temp_dir,
         vendor_packages,
         linux_override,
         firmware_override,
) base_packages(suite,
                product,
                temp_dir,
                vendor_packages,
                linux_override,
                firmware_override,
) + {
    mmdebstrap+: {
        packages+:
        [
            "foot",
            "weston",
            "xwayland",
            "fonts-noto-cjk",
            "fonts-noto-core",
            "fonts-noto-mono",
            "fonts-noto-ui-core",
        ],
        "customize-hooks"+:
        [
            // Create weston config for user skeleton
            'mkdir -p "$1/etc/skel/.config"',
            // Copy weston.ini config for kiosk mode with fullscreen terminal
            'cat > "$1/etc/skel/.config/weston.ini" << EOF
[core]
shell=kiosk-shell.so
xwayland=true

[terminal]
font=Noto Sans Mono
font-size=14

[output]
name=*
mode=preferred

[autolaunch]
path=/usr/bin/foot
EOF',
            // Configure autologin on TTY1 using systemd override
            'mkdir -p "$1/etc/systemd/system/getty@tty1.service.d"',
            'cat > "$1/etc/systemd/system/getty@tty1.service.d/override.conf" << EOF
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin radxa --noclear %I $TERM
EOF',
            // Create profile script to auto-start weston on TTY1
            'cat > "$1/etc/profile.d/weston.sh" << EOF
if [ -z "\\$DISPLAY" ] && [ -z "\\$WAYLAND_DISPLAY" ] && [ "\\$(tty)" = "/dev/tty1" ]; then
    exec weston --log=/tmp/weston.log
fi
EOF',
        ]
    },
}
