local desktop_packages = import "categories/desktop.libjsonnet";

function(suite,
         product,
         temp_dir,
         vendor_packages,
         linux_override,
         firmware_override,
) desktop_packages(suite,
                product,
                temp_dir,
                vendor_packages,
                linux_override,
                firmware_override,
) + {
    mmdebstrap+: {
        packages+:
        [
            "foot",
            "weston",
            "xwayland",
        ] +

(if suite == "bookworm"
then
        // Install Debian 12 packages
        [
            "greetd",
        ]
else
        []
),
        "customize-hooks"+:
        [
            // Create weston config directory for user skeleton
            'mkdir -p "$1/etc/skel/.config/weston"',
            // Copy weston.ini config for kiosk mode with fullscreen terminal
            'cat > "$1/etc/skel/.config/weston/weston.ini" << EOF
[core]
shell=kiosk-shell.so
xwayland=true

[terminal]
font=Noto Sans Mono
font-size=14

[output]
name=*
mode=preferred
transform=normal

[shell]
client=/usr/bin/foot --fullscreen
EOF',
            // Override greetd config to launch weston instead of sway
            'cat > "$1/etc/greetd/config.toml" << EOF
[terminal]
vt = 7

[default_session]
command = "weston"
user = "radxa"
EOF',
        ]
    },
}
